@{
    Layout = "_Layout";
}

<style>
    /* CSS kodların aynı kalıyor, yer kaplamaması için burayı özet geçiyorum */
    .deposit-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        padding: 2.5rem 0;
    }

    .deposit-card {
        width: 100%;
        max-width: 32rem;
        background-color: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        color: #d1d5db;
        margin-bottom: 0.5rem;
        margin-left: 0.25rem;
    }

    .input-field {
        width: 100%;
        background-color: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        color: white;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-field:focus {
            border-color: #6366f1;
        }

    .card-info-box {
        background-color: rgba(0, 0, 0, 0.2);
        padding: 1.25rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section-title {
        color: white;
        font-weight: 700;
        font-size: 0.875rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 0.5rem;
        margin-bottom: 0.25rem;
    }

    .card-input {
        width: 100%;
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        color: white;
        font-size: 0.875rem;
        outline: none;
        transition: all 0.2s;
    }

        .card-input:focus {
            border-color: #6366f1;
            background-color: rgba(255, 255, 255, 0.1);
        }

        .card-input::placeholder {
            color: #6b7280;
        }

    .row-inputs {
        display: flex;
        gap: 0.75rem;
    }

    .half-width {
        width: 50%;
    }

    .btn-submit {
        width: 100%;
        margin-top: 1.5rem;
        background-color: #4f46e5;
        color: white;
        font-weight: 700;
        padding: 0.75rem;
        border-radius: 0.75rem;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.2s;
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.3);
    }

        .btn-submit:hover {
            background-color: #4338ca;
            transform: translateY(-2px);
        }
</style>

<div class="deposit-container">
    <div class="deposit-card">

        <h2 class="card-title">
            <i class="fas fa-wallet" style="margin-right: 10px; color: #818cf8;"></i>
            Cüzdana Para Yükle
        </h2>

        @using (Html.BeginForm("AddFunds", "Cuzdan", FormMethod.Post, new { id = "depositForm" }))
        {
            <input type="hidden" name="userId" value="@ViewBag.UserId" />

            <div class="form-group">
                <label class="form-label">Yüklenecek Tutar (₺)</label>
                @Html.TextBox("miktar", null, new
                    {
                        @class = "input-field",
                        type = "number",
                        required = "required",
                        placeholder = "0.00"
                    })
            </div>

            <div class="card-info-box">
                <p class="section-title">Kart Bilgileri</p>

                <div>
                    @Html.TextBox("kartAd", null, new
                        {
                            @class = "card-input",
                            placeholder = "Kart Sahibi Ad Soyad",
                            required = "required"
                        })
                </div>

                <div>
                    @Html.TextBox("kartNo", null, new
                        {
                            @class = "card-input",
                            placeholder = "0000 0000 0000 0000",
                            maxlength = "19",
                            required = "required",
                            style = "font-family: monospace;",
                            oninput = "formatCardNumber(this)"
                        })
                </div>

                <div class="row-inputs">
                    <div class="half-width">
                        @Html.TextBox("skt", null, new
                            {
                                @class = "card-input",
                                placeholder = "AA/YY",
                                maxlength = "5",
                                required = "required",
                                style = "text-align: center;",
                                oninput = "formatDate(this)"
                            })
                    </div>
                    <div class="half-width">
                        @Html.TextBox("cvv", null, new
                            {
                                @class = "card-input",
                                placeholder = "CVV",
                                maxlength = "3",
                                required = "required",
                                style = "text-align: center;"
                            })
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                YÜKLEMEYİ ONAYLA
            </button>
        }
    </div>
</div>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger" style="margin-top: 20px; text-align: center; color: red;">
        @TempData["Hata"]
    </div>
}

<script>
    function formatCardNumber(input) {
        let value = input.value.replace(/\D/g, '').substring(0, 16);
        input.value = value.match(/.{1,4}/g)?.join(' ') || value;
    }

    function formatDate(input) {
        let value = input.value.replace(/\D/g, '');
        if (value.length > 2) {
            value = value.substring(0, 2) + '/' + value.substring(2, 4);
        }
        input.value = value;
    }
</script>