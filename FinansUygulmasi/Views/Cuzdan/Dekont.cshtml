@{
    Layout = null; // Menü ve footer yok, sadece dekont kağıdı
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>İşlem Dekontu - Finans Cüzdan</title>
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background-color: #f3f4f6; /* Gri arka plan */
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: flex-start; /* Üstten başlasın */
            padding: 40px;
            color: #1f2937;
            min-height: 100vh;
        }

        .receipt-paper {
            background-color: white;
            width: 100%;
            max-width: 500px; /* Kağıt genişliği */
            padding: 40px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-top: 8px solid #2563eb; /* Mavi Çizgi */
            border-radius: 4px;
            position: relative;
        }

            /* Tırtıklı Kağıt Altı Efekti (Opsiyonel Süs) */
            .receipt-paper::after {
                content: "";
                position: absolute;
                bottom: -10px;
                left: 0;
                width: 100%;
                height: 10px;
                background: linear-gradient(45deg, transparent 33.333%, #ffffff 33.333%, #ffffff 66.667%, transparent 66.667%), linear-gradient(-45deg, transparent 33.333%, #ffffff 33.333%, #ffffff 66.667%, transparent 66.667%);
                background-size: 20px 20px;
            }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 20px;
        }

        .logo {
            font-size: 1.2rem;
            font-weight: 700;
            color: #111;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .receipt-title {
            font-size: 0.9rem;
            color: #6b7280;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; /* İki kolon */
            gap: 25px;
            margin-bottom: 30px;
        }

        .info-item label {
            display: block;
            font-size: 0.7rem;
            color: #6b7280;
            text-transform: uppercase;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .info-item span {
            display: block;
            font-size: 0.95rem;
            font-weight: 600;
            color: #111;
            word-break: break-word;
        }

        .total-section {
            background-color: #f8fafc;
            padding: 25px;
            border-radius: 8px;
            text-align: right;
            border: 1px solid #e2e8f0;
            margin-top: 20px;
        }

        .total-label {
            font-size: 0.8rem;
            color: #64748b;
            text-transform: uppercase;
            display: block;
            margin-bottom: 5px;
        }

        .total-amount {
            font-size: 2.2rem;
            font-weight: 700;
            color: #2563eb; /* Mavi renk */
            font-family: 'Courier Prime', monospace; /* Para fontu */
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 0.7rem;
            color: #9ca3af;
            border-top: 1px dashed #e5e7eb;
            padding-top: 20px;
            line-height: 1.5;
        }

        /* Butonlar Alanı */
        .action-buttons {
            margin-top: 30px;
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.9rem;
            border: none;
            transition: all 0.2s;
        }

        .btn-print {
            background-color: #1f2937;
            color: white;
        }

            .btn-print:hover {
                background-color: #000;
            }

        .btn-home {
            background-color: #e5e7eb;
            color: #374151;
        }

            .btn-home:hover {
                background-color: #d1d5db;
            }


        /* --- YAZDIRMA AYARLARI (Print Mode) --- */
        @@media print {
            body

        {
            background-color: white;
            padding: 0;
            margin: 0;
            display: block;
        }

        .receipt-paper {
            box-shadow: none;
            border: none;
            max-width: 100%;
            width: 100%;
            padding: 0;
            border-top: none; /* Üst çizgiyi kaldırabiliriz tasarruf için */
        }

            /* Tırtıklı efekti gizle */
            .receipt-paper::after {
                display: none;
            }

        .action-buttons {
            display: none !important; /* Butonları gizle */
        }

        .total-section {
            background-color: #f8fafc !important; /* Arka planı korumaya çalış */
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        }
    </style>
</head>
<body>

    <div class="receipt-paper">
        <div class="header">
            <div class="logo">
                <i class="fas fa-wallet" style="color:#2563eb;"></i> FinansCüzdan
            </div>
            <div class="receipt-title">
                #@DateTime.Now.ToString("yyyyMMdd")-@ViewBag.UserId
            </div>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <label>Sayın</label>
                <span>@ViewBag.AdSoyad</span>
            </div>
            <div class="info-item">
                <label>İşlem Tarihi</label>
                <span>@ViewBag.Tarih</span>
            </div>
            <div class="info-item">
                <label>İşlem Türü</label>
                <span>Bakiye Yükleme</span>
            </div>
            <div class="info-item">
                <label>Kullanılan Kart</label>
                <span>**** **** **** @ViewBag.KartSonDort</span>
            </div>
            <div class="info-item">
                <label>Durum</label>
                <span style="color: green;">✔ Başarılı</span>
            </div>
        </div>

        <div class="total-section">
            <span class="total-label">YÜKLENEN TUTAR</span>
            <div class="total-amount">
                @string.Format("{0:N2} ₺", ViewBag.Tutar)
            </div>
        </div>

        <div class="footer">
            Bu belge elektronik ortamda oluşturulmuştur ve ıslak imza gerektirmez.<br>
            Finans Uygulaması A.Ş. - Mersis No: 0123456789
        </div>

        <div class="action-buttons">
            <button onclick="window.print()" class="btn btn-print">
                <i class="fas fa-print"></i> Yazdır / PDF
            </button>
            <a href="/Home/Index/@ViewBag.UserId" class="btn btn-home">
                Ana Sayfaya Dön
            </a>
        </div>
    </div>

</body>
</html>