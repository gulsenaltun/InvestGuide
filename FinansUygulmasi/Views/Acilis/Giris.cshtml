@model FinansUygulmasi.Models.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!--Esneklik için en önemli yer burası-->
    <title>Giriş Yap - Finans AI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #0f0c29;
            background-image: linear-gradient(to right, #24243e, #302b63, #0f0c29);
            color: #fff;
            min-height: 100vh;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /*giris ekranı için*/
        .giris-paneli {
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 50px 40px;
            width: 90%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
        }

            .giris-paneli h2 {
                margin-bottom: 10px;
                color: #fff;
                font-size: 2rem;
            }

            .giris-paneli p {
                color: #aaa;
                font-size: 0.9rem;
                margin-bottom: 30px;
            }

        .ozel-input-stili {
            width: 100%;
            padding: 15px 15px 15px 45px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            color: #fff;
            outline: none;
            margin-bottom: 20px;
            transition: 0.3s;
            font-size: 1rem;
        }

            .ozel-input-stili:focus {
                border-color: #ffd700;
                background: rgba(0, 0, 0, 0.5);
                box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
            }

        .girdi-satiri {
            position: relative;
            text-align: left;
        }

        .girdi-ikonu {
            position: absolute;
            left: 15px;
            top: 42px;
            color: #ffd700;
            z-index: 2;
        }

        .giris-yap-butonu {
            width: 100%;
            padding: 15px;
            background: linear-gradient(45deg, #ffd700, #ff8c00);
            border: none;
            border-radius: 30px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            color: #000;
            transition: transform 0.2s;
            margin-top: 10px;
            box-shadow: 0 5px 15px rgba(255, 215, 0, 0.3);
        }

            .giris-yap-butonu:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 25px rgba(255, 215, 0, 0.5);
            }

        .hata-kutusu {
            color: #ff6b6b;
            margin-bottom: 15px;
            background: rgba(255,0,0,0.1);
            padding: 10px;
            border-radius: 10px;
            font-size: 0.9rem;
        }

        .input-etiketi {
            color: #ccc;
            margin-left: 15px;
            font-size: 0.9rem;
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .sifre-link{
            color: #ccc;
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.3s;
        }

        .sifre-link:hover {
            color: #ffd700;
            text-decoration: underline;
        }

        /*mobil için uyumluluk*/
        @@media screen and (max-width: 600px) {
            .giris-paneli {
                padding: 30px 20px;
                width: 95%;
            }

                .giris-paneli h2 {
                    font-size: 1.5rem;
                }

            .ucan-simge {
                font-size: 1.5rem !important;
            }

            .ozel-input-stili {
                padding: 12px 15px 12px 40px;
                margin-bottom: 15px;
            }

            .girdi-ikonu {
                top: 38px;
            }
        }

    </style>
</head>
    <body>

    @await Html.PartialAsync("_ArkaPlan")

    <div class="arka-plan-izgara"></div>

    <!--Giriş ekranı-->
    <div class="giris-paneli">
        <h2>Giriş Yap</h2>
        <p>Yapay zeka ile yatırımlarını yönet</p>

        @if (ViewBag.Hata != null)
        {
            <div class="hata-kutusu">
                <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Hata
            </div>
        }

        @using (Html.BeginForm("Giris", "Acilis", FormMethod.Post))
        {
            <div class="girdi-satiri">
                @Html.LabelFor(m => m.Email, new { @class = "input-etiketi" })
                <i class="fa-solid fa-envelope girdi-ikonu"></i>
                @Html.TextBoxFor(m => m.Email, new { @class = "ozel-input-stili", placeholder = "E-Mail" })
            </div>

            <div class="girdi-satiri">
                @Html.LabelFor(m => m.Password, new { @class = "input-etiketi" })
                <i class="fa-solid fa-lock girdi-ikonu"></i>
                @Html.PasswordFor(m => m.Password, new { @class = "ozel-input-stili", placeholder = "*****" })
            </div>

            <button type="submit" class="giris-yap-butonu">Giriş Yap</button>

            <div style="margin-top: 15px;">
                @Html.ActionLink("Şifreni mi unuttun?", "SifremiUnuttum", "Acilis", null, new {@class ="sifre-link"})
            </div>
        }
    </div>

    </body>
</html>