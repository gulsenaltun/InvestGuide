@using FinansUygulmasi.Models.ViewModels
@using FinansUygulmasi.Controllers
@model List<MarketDetailViewModel>

<style>
    /* CSS kodları aynen kalıyor, dokunmana gerek yok */
    .currency-list { display: flex; flex-direction: column; gap: 1rem; }
    .currency-card { background-color: rgba(255,255,255,0.95); backdrop-filter: blur(4px); border-radius: 0.75rem; padding: 1rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border-left-width: 5px; border-left-style: solid; display: flex; flex-direction: column; justify-content: space-between; align-items: center; gap: 1rem; transition: transform 0.2s ease; }
    .currency-card:hover { transform: scale(1.01); }
    @@media(min-width: 768px) { .currency-card { flex-direction: row; } }
    .info-area { display: flex; align-items: center; gap: 1rem; width: 100%; }
    .icon-box { padding: 0.75rem; border-radius: 50%; box-shadow: inset 0 2px 4px 0 rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; font-size: 1.25rem; }
    .text-details p { font-size: 0.75rem; color: #6b7280; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0; }
    .text-details h3 { margin: 0; font-size: 1.5rem; font-weight: 800; color: #1f2937; }
    .action-buttons { display: flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: flex-end; }
    .btn-action { padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.875rem; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: background-color 0.2s; color: white; border: none; font-weight: 600; cursor: pointer; }
    .btn-buy { background-color: #16a34a; }
    .btn-buy:hover { background-color: #15803d; }
    .btn-sell { background-color: #dc2626; }
    .btn-sell:hover { background-color: #b91c1c; }
    .btn-ai { background-color: #4f46e5; border: 1px solid #6366f1; }
    .btn-ai:hover { background-color: #4338ca; }
    .theme-yellow { border-left-color: #eab308; }
    .icon-yellow { background-color: #fef9c3; color: #ca8a04; }
    .theme-green { border-left-color: #16a34a; }
    .icon-green { background-color: #dcfce7; color: #16a34a; }
    .theme-blue { border-left-color: #2563eb; }
    .icon-blue { background-color: #dbeafe; color: #2563eb; }
    .theme-gray { border-left-color: #6b7280; }
    .icon-gray { background-color: #f3f4f6; color: #4b5563; }
    .theme-orange{ border-left-color: #f97316; }
    .icon-orange{ background-color: #ffedd5; color: #ea580c; }
    .desktop-text { display: none; }
    @@media(min-width: 1024px) { .desktop-text { display: inline; } }
    .btn-disabled { background-color: #9ca3af !important; cursor: not-allowed; opacity: 0.7; pointer-events: none; border: 1px solid #6b7280; }
</style>

<div class="currency-list">

    @if (Model !=null)
    {
        @foreach (var kur in Model)
        {
            var (renkKodu, ikon) = kur.Symbol switch
            {
                "GOLD" => ("yellow", "fa-coins"),
                "USD" => ("green", "fa-dollar-sign"),
                "EUR" => ("blue", "fa-euro-sign"),
                "BTC" => ("orange", "fa-brands fa-bitcoin"),
                _ => ("gray", "fa-circle")
            };

            var finalIcon = !string.IsNullOrEmpty(kur.IconClass) ? kur.IconClass : "fas" + ikon;
            
            // Altın sembolünü burada düzeltiyoruz (Linke XAU gidecek)
            var aiSymbol = (kur.Symbol == "GA" || kur.Symbol == "GOLD") ? "XAU" : kur.Symbol;

            <div class="currency-card theme-@renkKodu">

                <div class="info-area">
                    <div class="icon-box icon-@renkKodu">
                        <i class="@finalIcon"></i>
                    </div>

                    <div class="text-details">
                        <p>@kur.Name</p>
                        <h3>@kur.CurrentPrice.ToString("N2") ₺</h3>
                    </div>
                </div>

                <div class="action-buttons">
                    @if (AdminController.MarketErisimiAcik == true)
                    {
                        // --- MARKET AÇIKSA: HER ŞEY AKTİF ---

                        @Html.ActionLink("Al", "Buy", "Market", new { symbol = kur.Symbol }, new { @class = "btn-action btn-buy" })

                        @Html.ActionLink("Sat", "Sell", "Market", new { symbol = kur.Symbol }, new { @class = "btn-action btn-sell" })

                        // ASİSTAN BUTONU (LİNK FORMATINDA)
                        // Tıklayınca Market/Ask sayfasına gider
                        <a href="@Url.Action("Ask", "Market", new { symbol = aiSymbol, price = kur.CurrentPrice })" 
                           class="btn-action btn-ai" 
                           title="Yapay Zeka Analizi">
                            <i class="fas fa-robot"></i>
                            <span class="desktop-text">Asistan</span>
                        </a>
                    }
                    else
                    {
                        // --- MARKET KAPALIYSA: AL/SAT PASİF ---

                        <button class="btn-action btn-disabled" disabled title="Market Kapalı">
                            <i class="fas fa-lock"></i> Al
                        </button>

                        <button class="btn-action btn-disabled" disabled title="Market Kapalı">
                            <i class="fas fa-lock"></i> Sat
                        </button>

                        // Asistan yine çalışsın ama sayfa değiştirecek
                        <a href="@Url.Action("Ask", "Market", new { symbol = aiSymbol, price = kur.CurrentPrice })" 
                           class="btn-action btn-ai" 
                           title="Yapay Zeka Analizi">
                            <i class="fas fa-robot"></i>
                            <span class="desktop-text">Asistan</span>
                        </a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            Piyasa verileri şu anda yükleniyor.
        </div>
    }
</div>