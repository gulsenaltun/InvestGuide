@model FinansUygulmasi.Models.ViewModels.MarketDetailViewModel

<style>
    .market-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        height: 100%;
    }

    /* Tablet ve Desktop için Grid Ayarı */
    @@media(min-width: 1024px) {
        .market-grid {
            grid-template-columns: 4fr 6fr;
        }
    }

    .glass-panel {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.5rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    /* Sol Panel (AI) Stilleri */
    .ai-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .ai-icon {
        font-size: 1.5rem;
        color: #818cf8;
    }

    .ai-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin: 0;
    }

    .ai-comment {
        color: #d1d5db;
        font-size: 0.875rem;
        font-style: italic;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }

    .prediction-box {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 0.75rem;
        padding: 1rem;
    }

    .pred-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .pred-row:last-child {
        margin-bottom: 0;
    }

    .pred-label {
        font-size: 0.875rem;
        color: #9ca3af;
    }

    .pred-value {
        font-weight: 700;
    }

    .trend-up {
        color: #4ade80;
    }

    .trend-down {
        color: #f87171;
    }

    .price-target {
        font-family: monospace;
        color: white;
    }

    .confidence-area {
        margin-top: 1.5rem;
    }

    .conf-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: #9ca3af;
        margin-bottom: 0.25rem;
    }

    .progress-track {
        width: 100%;
        background-color: #374151;
        border-radius: 9999px;
        height: 0.5rem;
        overflow: hidden;
    }

    .progress-fill {
        background-color: #6366f1;
        height: 100%;
        border-radius: 9999px;
    }

    /* Sağ Panel (Market) Stilleri */
    .market-content {
        text-align: center;
        margin-top: 1rem;
    }

    .coin-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    /* Renk Sınıfları */
    .text-yellow-400 { color: #facc15; }
    .text-green-400 { color: #4ade80; }
    .text-blue-400 { color: #60a5fa; }
    .text-orange-500 { color: #f97316; }
    .text-red-400 { color: #f87171; }

    .coin-name {
        font-size: 1.875rem;
        font-weight: 700;
        color: white;
        margin: 0;
    }

    .coin-price {
        font-size: 3rem;
        font-weight: 700;
        color: white;
        margin: 1rem 0;
    }

    .currency-symbol {
        font-size: 1.5rem;
    }

    .change-rate {
        font-weight: 700;
        font-size: 1.1rem;
    }

    /* Butonlar */
    .btn-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-base {
        padding: 1rem;
        border-radius: 0.75rem;
        text-align: center;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.2s;
        display: block;
        color: white;
        border: none;
        cursor: pointer;
    }

    .btn-buy { background-color: #16a34a; }
    .btn-buy:hover { background-color: #15803d; }

    .btn-sell { background-color: #dc2626; }
    .btn-sell:hover { background-color: #b91c1c; }
</style>

<div class="market-grid">
    <div class="glass-panel">
        <div>
            <div class="ai-header">
                <i class="fas fa-brain ai-icon"></i>
                <h3 class="ai-title">AI Tahmini</h3>
            </div>

            <p class="ai-comment">"@Model.AIComment"</p>

            <div class="prediction-box">
                <div class="pred-row">
                    <span class="pred-label">Yön</span>
                    <span class="pred-value @(Model.PredictionDirection == "Yükseliş" || Model.PredictionDirection == "Yukselis" ? "trend-up" : "trend-down")">
                        @Model.PredictionDirection
                    </span>
                </div>

                <div class="pred-row">
                    <span class="pred-label">Hedef Fiyat</span>
                    <span class="pred-value price-target">@Model.PredictedPrice.ToString("N2") ₺</span>
                </div>
            </div>
        </div>

        <div class="confidence-area">
            <div class="conf-header">
                <span>Güven Skoru</span>
                <span style="color: white; font-weight: bold;">%@Model.ConfidenceScore</span>
            </div>

            <div class="progress-track">
                <div class="progress-fill" style="width: @Model.ConfidenceScore%"></div>
            </div>
        </div>
    </div>

    <div class="glass-panel">
        <div class="market-content">
            <i class="fas @Model.IconClass coin-icon @Model.ColorClass"></i>

            <h2 class="coin-name">@Model.Name</h2>

            <div class="coin-price">
                @Model.CurrentPrice.ToString("N2")
                <span class="currency-symbol">₺</span>
            </div>

            <span class="change-rate @(Model.ChangeRate >= 0 ? "trend-up": "trend-down")">
                %@Model.ChangeRate.ToString("N2")
            </span>
        </div>

        <div>
            <div class="btn-grid">
                @Html.ActionLink("Al", "Buy", "Market",
                         new { symbol = Model.Symbol },
                         new { @class = "btn-base btn-buy" })

                @Html.ActionLink("Sat", "Sell", "Market",
                         new { symbol = Model.Symbol },
                         new { @class = "btn-base btn-sell" })
            </div>
        </div>
    </div>
</div>