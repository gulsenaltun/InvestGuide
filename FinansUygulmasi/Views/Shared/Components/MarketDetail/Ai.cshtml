@using FinansUygulmasi.Models.ViewModels
@model MarketDetailViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name + " Asistanı";

    // Renkleri belirliyoruz
    string themeColor = "#818cf8"; // Varsayılan
    if (Model.ColorClass.Contains("yellow")) { themeColor = "#facc15"; }
    else if (Model.ColorClass.Contains("green")) { themeColor = "#4ade80"; }
    else if (Model.ColorClass.Contains("blue")) { themeColor = "#60a5fa"; }
    else if (Model.ColorClass.Contains("orange")) { themeColor = "#f97316"; }
}

<style>
    /* Chat Kartı */
    .chat-card {
        width: 100%;
        max-width: 900px;
        height: 700px;
        background-color: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
        margin: 2rem auto;
    }

    /* Arka Plan Efekti */
    .glow-effect {
        position: absolute;
        top: -100px;
        right: -100px;
        width: 300px;
        height: 300px;
        background-color: @themeColor;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.15;
        pointer-events: none;
    }

    /* Header */
    .chat-header {
        padding: 1.5rem;
        background-color: rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header-icon-box {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        background-color: rgba(255,255,255,0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .header-icon {
        font-size: 1.75rem;
        color: @themeColor;
    }

    .header-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin: 0;
    }

    .status-text {
        font-size: 0.85rem;
        color: #9ca3af;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        background-color: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 5px #22c55e;
    }

    /* Mesaj Alanı */
    .chat-body {
        flex: 1;
        padding: 2rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Animasyon Düzeltmesi */
    .message {
        display: flex;
        gap: 1rem;
        max-width: 80%;
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .msg-ai {
        align-self: flex-start;
    }

    .msg-user {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .avatar {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ai-avatar {
        background-color: @themeColor;
        color: black;
        box-shadow: 0 0 15px @(themeColor) 40;
    }

    .user-avatar {
        background-color: #4f46e5;
        color: white;
    }

    .bubble {
        padding: 1rem 1.25rem;
        border-radius: 1.25rem;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .ai-bubble {
        background-color: rgba(255, 255, 255, 0.1);
        color: #e5e7eb;
        border-top-left-radius: 0;
    }

    .user-bubble {
        background-color: @themeColor;
        color: #000;
        font-weight: 600;
        border-top-right-radius: 0;
    }

    /* Footer */
    .chat-footer {
        padding: 1.5rem;
        background-color: rgba(0, 0, 0, 0.2);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .input-wrapper {
        display: flex;
        gap: 1rem;
    }

    .chat-input {
        flex: 1;
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        padding: 1rem 1.5rem;
        color: white;
        font-size: 1rem;
        outline: none;
        transition: all 0.3s;
    }

        .chat-input:focus {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: @themeColor;
        }

    .btn-send {
        background-color: @themeColor;
        color: black;
        border: none;
        width: 3.5rem;
        border-radius: 1rem;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
    }

        .btn-send:hover {
            transform: scale(1.05);
        }
</style>

<div class="chat-card">
    <div class="glow-effect"></div>

    <div class="chat-header">
        <div class="header-icon-box">
            <i class="fas @Model.IconClass header-icon"></i>
        </div>
        <div class="header-info">
            <h2 class="header-title">@Model.Name Asistanı</h2>
            <span class="status-text"><span class="status-dot"></span> Çevrimiçi</span>
        </div>
    </div>

    <div class="chat-body" id="chatArea">
        <div class="message msg-ai">
            <div class="avatar ai-avatar"><i class="fas fa-robot"></i></div>
            <div class="bubble ai-bubble">
                @Model.AIComment
            </div>
        </div>
    </div>

    <div class="chat-footer">
        <form class="input-wrapper" onsubmit="sendMessage(event)">
            <input type="text" id="userMessage" class="chat-input" placeholder="@Model.Name hakkında sor..." autocomplete="off">
            <button type="submit" class="btn-send"><i class="fas fa-paper-plane"></i></button>
        </form>
    </div>
</div>

<script>
    // Dinamik rengi JS'e taşıyoruz
    const themeColor = "@themeColor";

    function sendMessage(e) {
        e.preventDefault();
        const input = document.getElementById('userMessage');
        const text = input.value.trim();
        const chatArea = document.getElementById('chatArea');

        if(text === "") return;

        // Kullanıcı Mesajı
        // Not: Backtick (`) kullanımı Razor'da bazen renklendirmeyi bozar ama kod çalışır.
        // User bubble rengini buradan veriyoruz
        const userHtml = `
            <div class="message msg-user">
                <div class="avatar user-avatar"><i class="fas fa-user"></i></div>
                <div class="bubble" style="background-color: ${themeColor}; color: black; font-weight: 600; border-top-right-radius: 0;">
                    ${text}
                </div>
            </div>`;

        chatArea.insertAdjacentHTML('beforeend', userHtml);
        input.value = "";
        chatArea.scrollTop = chatArea.scrollHeight;

        // AI Yanıtı
        setTimeout(() => {
            const aiHtml = `
                <div class="message msg-ai">
                    <div class="avatar ai-avatar"><i class="fas fa-robot"></i></div>
                    <div class="bubble ai-bubble">
                        Henüz demo aşamasındayım ama <strong>"${text}"</strong> sorunu not ettim!
                    </div>
                </div>`;
            chatArea.insertAdjacentHTML('beforeend', aiHtml);
            chatArea.scrollTop = chatArea.scrollHeight;
        }, 1000);
    }
</script>