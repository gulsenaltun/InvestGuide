@model FinansUygulmasi.Models.ViewModels.TradeViewModel

@{
    Layout = "_Layout";
    // Controller'dan gelen "Sahip Olunan Miktar" verisini alıyoruz.
    // Eğer null gelirse (hata olmasın diye) 0 kabul ediyoruz.
    decimal sahipOlunan = ViewBag.SahipOlunan != null ? (decimal)ViewBag.SahipOlunan : 0;
}

<style>
    .sell-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
    }

    .sell-card {
        width: 100%;
        max-width: 28rem;
        background-color: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        position: relative;
        overflow: hidden;
    }

    .bg-blur-red {
        position: absolute;
        top: -2.5rem;
        right: -2.5rem;
        width: 10rem;
        height: 10rem;
        background-color: #dc2626;
        border-radius: 9999px;
        filter: blur(64px);
        opacity: 0.2;
        pointer-events: none;
    }

    .header-area {
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
        z-index: 10;
    }

    .icon-wrapper {
        width: 4rem;
        height: 4rem;
        background-color: rgba(239, 68, 68, 0.2);
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .sell-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.25rem;
    }

    .text-red {
        color: #ef4444;
    }

    .sell-subtitle {
        font-size: 0.875rem;
        color: #9ca3af;
        margin-top: 0.25rem;
    }

    .font-mono {
        font-family: monospace;
        font-weight: 700;
        color: white;
    }

    .input-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
        font-weight: 500;
        color: #d1d5db;
        margin-bottom: 0.5rem;
        margin-left: 0.25rem;
    }

    .balance-info {
        color: #f87171;
        font-size: 0.8rem;
        cursor: pointer;
        text-decoration: underline;
    }

    .sell-input-wrapper {
        position: relative;
    }

    .sell-input {
        width: 100%;
        background-color: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        padding: 1rem;
        color: white;
        font-family: monospace;
        font-size: 1.25rem;
        outline: none;
        transition: border-color 0.2s;
    }

        .sell-input:focus {
            border-color: #ef4444;
        }

    .input-error {
        border-color: #ff0000 !important;
        color: #ff0000 !important;
    }

    .suffix-text {
        position: absolute;
        right: 1rem;
        top: 1rem;
        font-weight: 700;
        color: #6b7280;
    }

    .summary-box {
        background-color: rgba(239, 68, 68, 0.1);
        border-radius: 0.75rem;
        padding: 1.25rem;
        border: 1px solid rgba(239, 68, 68, 0.2);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .summary-label {
        color: #fecaca;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .summary-value {
        font-size: 1.875rem;
        font-weight: 700;
        color: white;
        font-family: monospace;
    }

    .btn-sell-confirm {
        width: 100%;
        background: linear-gradient(to right, #dc2626, #ef4444);
        color: white;
        font-weight: 700;
        padding: 1rem;
        border-radius: 0.75rem;
        border: none;
        cursor: pointer;
        box-shadow: 0 10px 15px -3px rgba(220, 38, 38, 0.3);
        transition: transform 0.2s;
    }

        .btn-sell-confirm:hover {
            background: linear-gradient(to right, #ef4444, #f87171);
            transform: translateY(-2px);
        }

    /* BUTON PASİF HALİ */
    .btn-disabled {
        background: #4b5563 !important;
        cursor: not-allowed !important;
        opacity: 0.7;
    }

    /* Chrome, Safari, Edge ve Opera için okları kaldırır */
    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox için okları kaldırır */
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="sell-container">
    <div class="sell-card">
        <div class="bg-blur-red"></div>

        <div class="header-area">
            <div class="icon-wrapper">
                <i class="fas fa-arrow-down" style="font-size: 1.5rem; color: #f87171;"></i>
            </div>
            <h2 class="sell-title">@Model.Symbol <span class="text-red">BOZDUR</span></h2>
            <p class="sell-subtitle">Satış Kuru: <span class="font-mono">@Model.CurrentPrice.ToString("N2") ₺</span></p>

            @if (TempData["Hata"] != null)
            {
                <div style="color: #ff4444; background: rgba(255,0,0,0.1); padding: 10px; border-radius: 8px; margin-top: 10px; font-size: 0.9rem;">
                    <i class="fas fa-exclamation-circle"></i> @TempData["Hata"]
                </div>
            }
        </div>

        @using (Html.BeginForm("IslemTamamla", "Market", FormMethod.Post, new { id = "satisFormu", onsubmit = "return satisOnayi()", style = "position: relative; z-index: 10; display: flex; flex-direction: column; gap: 1.5rem;" }))
        {
            @Html.HiddenFor(m => m.Symbol)
            @Html.Hidden("islemTuru", "Satis")

            <div>
                <div class="input-label">
                    <span>Satılacak Miktar</span>

                    <span class="balance-info" onclick="hepsiniSec()" title="Tümünü seçmek için tıkla">
                        Mevcut: @sahipOlunan.ToString("N4")
                    </span>
                </div>

                <div class="sell-input-wrapper">
                    @Html.TextBoxFor(m => m.Amount, new
                        {
                            @class = "sell-input",
                            type = "number",
                            step = "any",
                            id = "miktar",
                            placeholder = "0.00",
                            required = "required",
                            autocomplete = "off",
                            // HTML tarafında da max sınırını koyuyoruz
                            max = sahipOlunan.ToString(System.Globalization.CultureInfo.InvariantCulture),

                            oninput = "hesapla()",
                            onfocus = "if(this.value==0) { this.value = ''; }",
                            onclick = "if(this.value==0) { this.value = ''; }",

                            // Açılışta 0 ise boş gelmesi için:
                            @Value = (Model.Amount == 0 ? "" : Model.Amount.ToString().Replace(",", "."))
                        })
                    <span class="suffix-text">@Model.Symbol</span>
                </div>

                <div id="hata-mesaji" style="color: #ef4444; font-size: 0.8rem; margin-top: 5px; min-height: 1.2rem;"></div>
            </div>

            <!--özet kısımı-->
            <div class="summary-box">
                <span class="summary-label">Hesabına Geçecek Tutar</span>
                <span class="summary-value" id="toplam">0,00 ₺</span>
            </div>

            <button type="submit" id="btn-submit" class="btn-sell-confirm">
                SATIŞI ONAYLA
            </button>
        }
    </div>
</div>

<script>
    // Server'dan gelen sayıları JS formatına (nokta) uygun şekilde alıyoruz
    const sahipOlunanMiktar = @sahipOlunan.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const anlikFiyat = @Model.CurrentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

    function hesapla() {
        const miktarInput = document.getElementById('miktar');
        // Virgül girilirse noktaya çevir
        const miktarDegeri = miktarInput.value.replace(',', '.');
        const btnSubmit = document.getElementById('btn-submit');
        const hataMesaji = document.getElementById('hata-mesaji');
        const toplamText = document.getElementById('toplam');

        let girilenMiktar = parseFloat(miktarDegeri);

        // Geçersiz veya Negatif sayı
        if (isNaN(girilenMiktar) || girilenMiktar < 0) {
            toplamText.innerText = "0,00 ₺";
            return;
        }

        // Bakiye Yeterli mi?
        if (girilenMiktar > sahipOlunanMiktar) {
            hataMesaji.innerText = "Yetersiz Bakiye! En fazla " + sahipOlunanMiktar + " satabilirsiniz.";
            hataMesaji.style.fontWeight = "bold";
            miktarInput.classList.add("input-error");

            // Butonu kilitle
            btnSubmit.classList.add("btn-disabled");
            btnSubmit.disabled = true;
        } else {
            // Her şey yolundaysa temizle
            hataMesaji.innerText = "";
            miktarInput.classList.remove("input-error");

            // Butonu aç
            btnSubmit.classList.remove("btn-disabled");
            btnSubmit.disabled = false;
        }

        // Fiyat Hesaplama ve Ekrana Yazma
        const toplam = girilenMiktar * anlikFiyat;

        // Türkçe para formatı (TL simgesi ve binlik ayıraç)
        toplamText.innerText = new Intl.NumberFormat('tr-TR', {
            style: 'currency',
            currency: 'TRY'
        }).format(toplam);
    }

    // "Mevcut: X" yazısına tıklayınca çalışır
    function hepsiniSec() {
        const kutu = document.getElementById('miktar');
        kutu.value = sahipOlunanMiktar;
        // Kutuyu doldurduktan sonra hesaplamayı tetikle ki toplam tutar güncellensin
        hesapla();
    }

    // Form gönderilmeden hemen önce tarayıcı sorar
    function satisOnayi() {
        const girilen = document.getElementById('miktar').value;

        if(girilen == "" || girilen == 0) {
            alert("Lütfen geçerli bir miktar giriniz.");
            return false; // Gönderme
        }

        // Onay kutusu çıkar
        return confirm(girilen + " adet @Model.Symbol satmak üzeresiniz. \n\nBu işlem geri alınamaz. Onaylıyor musunuz?");
    }
</script>