@model FinansUygulmasi.Models.ViewModels.TradeViewModel

@{
    Layout = "_Layout";
    // Cüzdan bakiyesini değişkene alıyoruz
    decimal cuzdanBakiyesi = Model.WalletBalance;
}

<style>

    .page-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        padding: 0;
    }

    .buy-card {
        width: 100%;
        max-width: 64rem;
        background-color: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .left-panel {
        width: 100%;
        padding: 2rem;
        background: linear-gradient(to bottom right, rgba(20, 83, 45, 0.4), rgba(0, 0, 0, 0.4));
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .right-panel {
        width: 100%;
        padding: 2rem;
        background-color: rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    @@media(min - width: 768px)
    {
        .buy-card{
            flex-direction: row;
        }

        .left-panel {
            width: 50%;
        }

        .right-panel {
            width: 50%;
        }

    }

    .input-field {
        width: 100%;
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 1rem;
        color: white;
        font-size: 1.25rem;
        border-radius: 0.75rem;
        outline: none;
    }

    /* Hata durumunda kırmızı çerçeve */
    .input-error {
        border-color: #ff4444 !important;
        color: #ff4444 !important;
    }

    .btn-submit {
        width: 100%;
        margin-top: 2rem;
        background: linear-gradient(to right, #16a34a, #22c55e);
        color: white;
        font-weight: 700;
        padding: 1rem;
        border-radius: 0.75rem;
        border: none;
        cursor: pointer;
    }

    /* Buton Pasif Hali */
    .btn-disabled {
        background: #4b5563 !important; /* Gri renk */
        cursor: not-allowed !important;
        opacity: 0.7;
    }

    .wallet-box {
        background: rgba(255,255,255,0.05);
        padding: 1.5rem;
        border-radius: 1rem;
        border: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 2rem;
    }

    .wallet-label {
        color: #9ca3af;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .wallet-amount {
        font-size: 2rem;
        font-weight: 700;
        color: white;
        font-family: monospace;
    }

    .deposit-link {
        color: #818cf8;
        text-decoration: none;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        display: inline-block;
    }

    .total-display {
        margin-top: 1rem;
        padding: 1rem;
        background: rgba(255,255,255,0.05);
        border-radius: 0.75rem;
        border: 1px dashed rgba(255,255,255,0.2);
    }

    .total-label {
        color: #9ca3af;
        font-size: 0.85rem;
    }

    /* Chrome, Safari, Edge ve Opera için okları kaldırır */
    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox için okları kaldırır */
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="page-container">
    @using (Html.BeginForm("IslemTamamla", "Market", FormMethod.Post, new { @class = "buy-card", onsubmit = "return alisOnayi()" }))
    {
        @Html.HiddenFor(m => m.Symbol)
        @Html.Hidden("islemTuru", "Alis")

        <div class="left-panel">
            <h2 style="color:white; font-size: 1.8rem; font-weight: 700; margin-bottom: 0;">@Model.Symbol SATIN AL</h2>
            <p style="color:#9ca3af; margin-bottom: 2rem;">Kur: @Model.CurrentPrice.ToString("N2") ₺</p>

            <div style="margin-bottom: 1.5rem;">
                <label style="color:#d1d5db; display:block; margin-bottom:0.5rem;">Alınacak Miktar</label>
                @Html.TextBoxFor(m => m.Amount, new
                    {
                        @class = "input-field",
                        type = "number",
                        step = "any",
                        id = "miktar",
                        required = "required",
                        oninput = "hesapla()",
                        placeholder = "0.00",
                        autocomplete = "off",
                        onfocus = "if(this.value==0) { this.value = ''; }",
                        onclick = "if(this.value==0) { this.value = ''; }",
                        @Value = (Model.Amount == 0 ? "" : Model.Amount.ToString().Replace(",", "."))
                    })
            </div>

            <!--yetersiz bakiye için uyarı alanı-->
            <div id="hata-mesaji" style="color: #ff4444; font-size: 0.85rem; margin-bottom: 10px; min-height: 1.2rem;"></div>

            <div class="total-display">
                <div class="total-label" id="toplam">0,00 ₺</div>
            </div>
        </div>

        <div class="right-panel">

            <div class="wallet-box">
                <p class="wallet-label">Mevcut Cüzdan Bakiyesi</p>
                <p class="wallet-amount" id="cuzdan-gosterge">@Model.WalletBalance.ToString("N2") ₺</p>

                <a href="@Url.Action("Deposit", "Cuzdan")" class="deposit-link">
                    <i class="fas fa-plus-circle"></i> Bakiye Yükle
                </a>

            </div>

            <p style="color: #9ca3af; font-size: 0.9rem; line-height: 1.5;">
                Bu işlem tutarı doğrudan cüzdan bakiyenizden düşülecektir.
                Yetersiz bakiye durumunda işlem gerçekleşmez.
            </p>

            <button type="submit" id="btn-submit" class="btn-submit">
                SATIN ALMAYI ONAYLA
            </button>
        </div>
    }
</div>

<script>
    // Server verilerini JS değişkenlerine alıyoruz
    const cuzdanBakiyesi = @cuzdanBakiyesi.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const birimFiyat = @Model.CurrentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

    function hesapla() {
        const miktarInput = document.getElementById('miktar');
        const toplamElement = document.getElementById('toplam');
        const btnSubmit = document.getElementById('btn-submit');
        const hataMesaji = document.getElementById('hata-mesaji');

        //Girdiyi al
        let miktarText = miktarInput.value;
        if (miktarText.trim() === "") {
            toplamElement.innerText = "0,00 ₺";
            hataMesaji.innerText = "";
            return;
        }

        // Sayıya çevir
        let miktar = parseFloat(miktarText.replace(',', '.'));

        if (!isNaN(miktar) && miktar > 0) {
            // Toplam Tutarı Hesapla
            let toplamTutar = miktar * birimFiyat;

            // Ekrana Yaz (Formatlı)
            toplamElement.innerText = new Intl.NumberFormat('tr-TR', {
                style: 'currency',
                currency: 'TRY'
            }).format(toplamTutar);

            // Para yetiyor mu?
            if (toplamTutar > cuzdanBakiyesi + 0.01) {
                hataMesaji.innerText = "Yetersiz Bakiye! Bu işlem için bakiyeniz yetmiyor.";
                hataMesaji.style.fontWeight = "bold";
                miktarInput.classList.add("input-error");

                // Butonu Kilitle
                btnSubmit.classList.add("btn-disabled");
                btnSubmit.disabled = true;
            } else {
                // Her şey yolundaysa
                hataMesaji.innerText = "";
                miktarInput.classList.remove("input-error");

                // Butonu Aç
                btnSubmit.classList.remove("btn-disabled");
                btnSubmit.disabled = false;
            }

        } else {
            toplamElement.innerText = "0,00 ₺";
            hataMesaji.innerText = "";
        }
    }

    // Form Gönderilmeden Önce Çalışacak Fonksiyon
    function alisOnayi() {
        const girilen = document.getElementById('miktar').value;
        const miktar = parseFloat(girilen.replace(',', '.'));
        const toplamTutar = miktar * birimFiyat;

        // Boşsa gönderme
        if(girilen == "" || girilen == 0 || isNaN(miktar)) {
            alert("Lütfen geçerli bir miktar giriniz.");
            return false;
        }

        // JS engeli aşılıp buton aktif edildiyse, son bir bakiye kontrolü daha
        if (toplamTutar > cuzdanBakiyesi + 0.01) {
            alert("Yetersiz Bakiye!");
            return false;
        }

        // ONAY KUTUSU (ALERT)
        return confirm(girilen + " adet @Model.Symbol almak üzeresiniz.\n\nToplam Tutar: " +
            new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(toplamTutar) +
            "\n\nOnaylıyor musunuz?");
    }
</script>